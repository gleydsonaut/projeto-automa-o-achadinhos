# Copie para .env (ignorado pelo Git). Nunca adicione segredos a arquivos públicos.
PORT=3138
OFERTA_ORIGIN=http://127.0.0.1:3138

# Cliente OAuth do tipo "Aplicativo da Web" no Google Cloud.
# URI de redirecionamento autorizada:
# http://127.0.0.1:3138/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
